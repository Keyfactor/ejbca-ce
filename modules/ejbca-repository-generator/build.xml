<project name="ejbca-repository-generator" default="build">
    <description>
            Generates all JPA entity classes and its helper classes
    </description>

	<dirname property="ejbca-repository-generator.dir" file="${ant.file.ejbca-repository-generator}"/>

    <import file="${ejbca-repository-generator.dir}/../build-helpers.xml"/>

	<property name="ejbca.home" value="/home/gustav-hallen/projects/ejbca" />
	<property name="java.target.version" value="21" />
	<property name="ejbca-repository-generator.build.dir" location="${ejbca-repository-generator.dir}/build"/>
	<property name="ejbca-repository-generator.build-test.dir" location="${ejbca-repository-generator.dir}/build-test"/>
	<property name="ejbca-repository-generator.src.dir" location="${ejbca-repository-generator.dir}/src"/>
	<property name="ejbca-repository-generator.src-test.dir" location="${ejbca-repository-generator.dir}/src-test"/>
	<property name="ejbca-repository-generator.resources.dir" location="${ejbca-repository-generator.dir}/resources"/>

	<path id="test.classpath">
		<path refid="compile.classpath"/>
		<path refid="lib.junit.classpath"/>
	</path>

	<path id="compile.classpath">
		<fileset dir="${ejbca.home}/lib" includes="freemarker-*.jar"/>
		<fileset dir="${ejbca.home}/lib/ext/jackson2">
			<include name="jackson-annotations-2.*.jar"/>
			<include name="jackson-databind-2.*.jar"/>
			<include name="jackson-core-2.*.jar"/>
			<include name="jackson-dataformat-yaml-2.*.jar"/>
		</fileset>
	</path>

	<path id="compile-test.classpath">
		<path refid="compile.classpath"/>
		<path refid="lib.junit.classpath"/>
	</path>

	<path id="generate.classpath">
		<path refid="compile.classpath"/>
		<path location="${ejbca-repository-generator.build-test.dir}"/>
		<path location="${ejbca-repository-generator.build.dir}"/>
	</path>

    <target name="clean" description="Clean up this module">
		<delete dir="${ejbca-repository-generator.build.dir}" />
    </target>
	
    <target name="build" description="Generates all classes for ejbca-repository" depends="compile">
		<echo message="ejbca-repository-generator.build.dir=${ejbca-repository-generator.build.dir}"/>
	</target>

    <target name="compile" depends="">
		<echo message="*** Generating source" />
		<echo message="${ejbca-repository-generator.build.dir}" />
    	<mkdir dir="${ejbca-repository-generator.build.dir}" />
        <javac srcdir="${ejbca-repository-generator.src.dir}" destdir="${ejbca-repository-generator.build.dir}" debug="on" includeantruntime="no"
        	encoding="UTF-8" target="${java.target.version}" classpathref="compile.classpath"/>
    </target>

	<target name="test:unit" depends="compile-test" description="Run unit tests for this module">
    	<antcall target="showtime" inheritall="true" inheritrefs="true"/>
		<echo message=" ** Running EJBCA entity tests **"/>
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}" dir="${ejbca-repository-generator.dir}">
			<classpath>
	    		<path refid="compile-test.classpath"/>
			</classpath>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${ejbca-repository-generator.build-test.dir}" includes="**/*UnitTest.class"/>
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
    	<antcall target="showtime" inheritall="true" inheritrefs="true"/>
    </target>

	<!-- ejbca-common,  -->
	<target name="compile-test" depends="build">
	    	<mkdir dir="${ejbca-repository-generator.build-test.dir}" />
	        <javac destdir="${ejbca-repository-generator.build-test.dir}" debug="on" includeantruntime="no"
	        	encoding="UTF-8" target="${java.target.version}" classpathref="compile-test.classpath">
		    	<src path="${ejbca-repository-generator.src-test.dir}"/>
	        </javac>
			<copy todir="${ejbca-repository-generator.build-test.dir}" failonerror="true">
				<fileset dir="${ejbca-repository-generator.src-test.dir}">
					<include name="**/*.xml"/>
				</fileset>
				<fileset dir="${ejbca.home}/src" includes="intresources/**"/>
				<fileset dir="${ejbca.home}/src/java/" includes="defaultvalues.properties"/>
			</copy>
	    </target>

	<!-- Only try to run the build-cli target if the directory exists.
	     This is all needed because we can not specify a non existing (optional) path on the compile-tests above -->

	<target name="runone" depends="compile-test">
		<fail message="'test.runone' is not set. Example -Dtest.runone=FooBarUnitTest . You can also use -Dtest.showoutput=true to send test output to console." unless="test.runone" />
        <copy file="${log4j.test.file}" tofile="${ejbca-repository-generator.build-test.dir}/log4j.xml" failonerror="true"/>
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}">
			<classpath>
        		<path refid="compile-test.classpath"/>
			</classpath>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${ejbca-repository-generator.build-test.dir}">
					<include name="**/${test.runone}.class" />
				</fileset>
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
	</target>

</project>
