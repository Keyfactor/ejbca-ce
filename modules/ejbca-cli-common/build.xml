<?xml version="1.0" encoding="UTF-8"?>
<project name="ejbca-cli-common" default="build">
    <description>
            Build files for the EJBCA CLI common module
    </description>

    <dirname property="ejbca-cli-common.dir" file="${ant.file.ejbca-cli-common}"/>

    <import file="${ejbca-cli-common.dir}/../build-helpers.xml"/>

    <property name="ejbca-cli-common.build.dir" location="${ejbca-cli-common.dir}/build"/>
    <property name="ejbca-cli-common.build-test.dir" location="${ejbca-cli-common.dir}/build-test"/>
    <property name="ejbca-cli-common.src.dir" location="${ejbca-cli-common.dir}/src"/>
    <property name="ejbca-cli-common.src-test.dir" location="${ejbca-cli-common.dir}/src-test"/>
    <property name="ejbca-cli-common.resources.dir" location="${ejbca-cli-common.dir}/resources"/>

    <path id="compile.classpath">
        <path refid="lib.jee.classpath"/>
        <path refid="lib.jee-client.classpath"/>
        <path refid="lib.jboss-logging.classpath"/>
        <path refid="lib.commons-logging.classpath"/>
        <path refid="lib.log4j.classpath"/>
    </path>

    <path id="compile-test.classpath">
        <path refid="compile.classpath"/>
        <path refid="lib.junit.classpath"/>
        <path refid="lib.test.classpath"/>
    </path>

    <path id="test.classpath">
        <path refid="compile-test.classpath"/>
    </path>

    <target name="clean" description="Clean up this module">
        <delete dir="${ejbca-cli-common.build.dir}"/>
        <delete dir="${ejbca-cli-common.build-test.dir}"/>
        <delete file="${mod.ejbca-cli-common.jar}"/>
    </target>

    <target name="build" description="Build this module" depends="compile">
        <jar destfile="${mod.ejbca-cli-common.lib}" basedir="${ejbca-cli-common.build.dir}" includes="**/*.class **/*.xml" />
    </target>

    <target name="compile" depends="setup">
        <javac srcdir="${ejbca-cli-common.src.dir}" destdir="${ejbca-cli-common.build.dir}" debug="on" includeantruntime="no" encoding="UTF-8" target="${java.target.version}"
            classpathref="compile.classpath"/>
    </target>

    <target name="setup">
        <mkdir dir="${ejbca-cli-common.build.dir}/WEB-INF/classes"/>
    </target>

    <target name="compile-tests" depends="build">
        <mkdir dir="${ejbca-cli-common.build-test.dir}" />
        <copy file="${log4j.test.file}" tofile="${ejbca-cli-common.build-test.dir}/log4j.xml" failonerror="true"/>
        <copy file="${jndi.properties.file}" tofile="${ejbca-cli-common.build-test.dir}/jndi.properties" failonerror="true"/>
        <copy file="${jboss-ejb-client.properties}" todir="${ejbca-cli-common.build-test.dir}" failonerror="true"/>
        <javac srcdir="${ejbca-cli-common.src-test.dir}" destdir="${ejbca-cli-common.build-test.dir}" debug="on" includeantruntime="no"
            encoding="iso8859-1" target="${java.target.version}" classpathref="compile-test.classpath">
            <sourcepath location="${mod.systemtests.path}/src-test/"/>
            <sourcepath location="${mod.systemtests.path}/src-interface/"/>
        </javac>
        <copy file="${internal.properties.file}" todir="${ejbca-cli-common.build-test.dir}" failonerror="true"/>
    </target>

    <target name="test:unit" depends="compile-tests" description="Run unit tests for this module">
        <antcall target="showtime" inheritall="true" inheritrefs="true"/>
        <condition property="remoteDebugJvmArgs"
                value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=8787"
                else="-ea">
            <istrue value="${remoteDebug}"/>
        </condition>
        <junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}" dir="${ejbca-cli-common.dir}" fork="true" forkmode="once">
            <classpath>
                <path refid="test.classpath"/>
            </classpath>
            <formatter type="xml" />
            <batchtest fork="yes" todir="${reports.dir}">
                <fileset dir="${ejbca-cli-common.build-test.dir}" includes="**/*UnitTest.class"/>
            </batchtest>
            <jvmarg line="${tests.jvmargs}"/>
            <jvmarg value="${remoteDebugJvmArgs}"/>
        </junit>
        <antcall target="showtime" inheritall="true" inheritrefs="true"/>
    </target>

    <target name="test:system" depends="compile-tests" description="Run system tests for this module">
        <antcall target="showtime" inheritall="true" inheritrefs="true"/>
        <condition property="remoteDebugJvmArgs"
                value="-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=8787"
                else="-ea">
            <istrue value="${remoteDebug}"/>
        </condition>
        <junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}" dir="${ejbca-cli-common.dir}" fork="true">
            <classpath>
                <path refid="test.classpath"/>
            </classpath>
            <formatter type="xml" />
            <batchtest fork="yes" todir="${reports.dir}">
                <fileset dir="${ejbca-cli-common.build-test.dir}" includes="**/*SystemTest.class"/>
            </batchtest>
            <jvmarg line="${tests.jvmargs}"/>
            <jvmarg value="${remoteDebugJvmArgs}"/>
        </junit>
        <antcall target="showtime" inheritall="true" inheritrefs="true"/>
    </target>

    <target name="runone" depends="compile-tests">
        <fail message="'test.runone' is not set. Example -Dtest.runone=SomeTest . You can also use -Dtest.showoutput=true to send test output to console." unless="test.runone" />
        <junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}">
            <classpath>
                <path refid="test.classpath"/>
            </classpath>
            <formatter type="xml" />
            <batchtest fork="yes" todir="${reports.dir}">
                <fileset dir="${ejbca-cli-common.build-test.dir}" includes="**/${test.runone}.class"/>
            </batchtest>
            <jvmarg line="${tests.jvmargs}"/>
        </junit>
    </target>
</project>
