<project name="ejbca-repository" default="build" basedir="../..">
    <description>
            Contains all JPA entity classes and its helper classes
    </description>

	<dirname property="ejbca-repository.dir" file="${ant.file.ejbca-repository}"/>

    <import file="${ejbca-repository.dir}/../build-helpers.xml"/>

	<property name="ejbca.home" value="/home/gustav-hallen/projects/ejbca" />
	<property name="java.target.version" value="21" />
	<property name="ejbca-repository.build.dir" location="${ejbca-repository.dir}/build"/>
	<property name="ejbca-repository-generator.build.dir" location="${ejbca-repository.dir}/../ejbca-repository-generator/build"/>
	<property name="ejbca-repository.build-test.dir" location="${ejbca-repository.dir}/build-test"/>
	<property name="ejbca-repository.src.dir" location="${ejbca-repository.dir}/src"/>
	<property name="ejbca-repository.src-test.dir" location="${ejbca-repository.dir}/src-test"/>
	<property name="ejbca-repository.resources.dir" location="${ejbca-repository.dir}/resources"/>

	<path id="compile.classpath">
		<path refid="lib.commons-config.classpath"/>
		<path refid="lib.commons-lang.classpath"/><!-- Dependency of commons-config -->
		<path refid="lib.commons-logging.classpath"/><!-- Dependency of commons-config -->
		<path refid="lib.bouncycastle.classpath"/>
		<path refid="lib.cryptotokens.classpath"/>
		<path refid="lib.xmlpull.classpath"/>
		<path location="${ejbca.home}/dist/cesecore-common.jar"/>
		<path location="${mod.cesecore-common.lib}"/>
		<fileset dir="${ejbca.home}/lib">
			<include name="freemarker-*.jar"/>
			<include name="log4j-*.jar"/>
		</fileset>
		<fileset dir="${ejbca.home}/lib/jee">
			<include name="*.jar"/>
		</fileset>
		<fileset dir="${ejbca.home}/lib/ext/jackson2">
			<include name="jackson-annotations-2.*.jar"/>
			<include name="jackson-databind-2.*.jar"/>
			<include name="jackson-core-2.*.jar"/>
			<include name="jackson-dataformat-yaml-2.*.jar"/>
		</fileset>
		<path location="${mod.ejbca-entity.lib}"/>
		<path location="${mod.cesecore-x509ca.lib}"/>
		<fileset dir="${ejbca.home}/lib" includes="x509-common-util*.jar"/>
	</path>

	<path id="compile-test.classpath">
		<path refid="compile.classpath"/>
		<path refid="lib.junit.classpath"/>
		<path location="${mod.ejbca-repository.lib}" />
	</path>

	<path id="test.classpath">
		<path refid="compile-test.classpath"/>
	</path>

    <target name="clean" description="Clean up this module">
		<delete dir="${ejbca-repository.build.dir}" />
    </target>

    <target name="compile">
    	<mkdir dir="${ejbca-repository.build.dir}" />
        <javac srcdir="${ejbca-repository.src.dir}" destdir="${ejbca-repository.build.dir}" debug="on" includeantruntime="no"
        	encoding="UTF-8" target="${java.target.version}" classpathref="compile.classpath"/>
    </target>

	<target name="test:unit" depends="compile-test" description="Run unit tests for this module">
    	<antcall target="showtime" inheritall="true" inheritrefs="true"/>
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}" dir="${ejbca-repository.dir}" >
			<classpath refid="test.classpath"/>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${ejbca-repository.build-test.dir}" includes="**/*UnitTest.class"/>
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
    	<antcall target="showtime" inheritall="true" inheritrefs="true"/>
    </target>

	<!-- ejbca-common,  -->
	<target name="compile-test" depends="build, build-cli-conditional">
		<mkdir dir="${ejbca-repository.build-test.dir}" />
		<javac srcdir="${ejbca-repository.src-test.dir}" destdir="${ejbca-repository.build-test.dir}" debug="on" includeantruntime="no"
			encoding="UTF-8" target="${java.target.version}" classpathref="compile-test.classpath"/>
		<copy todir="${ejbca-repository.build-test.dir}" failonerror="true">
			<fileset dir="${ejbca-repository.src-test.dir}">
				<include name="**/*.xml"/>
			</fileset>
			<fileset dir="${ejbca.home}/src" includes="intresources/**"/>
			<fileset dir="${ejbca.home}/src/java/" includes="defaultvalues.properties"/>
		</copy>
	</target>

	<target name="build" description="Build this module" depends="compile">
		<jar destfile="${mod.ejbca-repository.lib}" basedir="${ejbca-repository.build.dir}" includes="**/*.class **/*.xml" excludes="org/ejbca/util/DatabaseSchemaScriptCreator.class"/>
	</target>

    <condition property="cli-exists">
   		<available file="${ejbca-generator.src-cli.dir}/org" type="dir"/>
    </condition>
	<!-- Only try to run the build-cli target if the directory exists.
	     This is all needed because we can not specify a non existing (optional) path on the compile-tests above -->
    <target name="build-cli-conditional" if="${cli-exists}">
    	<antcall target="build-cli" inheritall="true" inheritrefs="true"/>
    </target>

	<target name="runone" depends="compile-test">
		<fail message="'test.runone' is not set. Example -Dtest.runone=FooBarUnitTest . You can also use -Dtest.showoutput=true to send test output to console." unless="test.runone" />
        <copy file="${log4j.test.file}" tofile="${ejbca-repository.build-test.dir}/log4j.xml" failonerror="true"/>
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}">
			<classpath>
				<path refid="test.classpath"/>
			</classpath>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${ejbca-repository.build-test.dir}">
					<include name="**/${test.runone}.class" />
				</fileset>
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
	</target>

</project>
