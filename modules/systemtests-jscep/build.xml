<?xml version="1.0" encoding="UTF-8"?>
<project name="systemtests-jscsp" default="test:system">

	<dirname property="systemtests-jscep.dir" file="${ant.file.systemtests-jscep}"/>

	<import file="../build-helpers.xml"/>

	<property name="systemtests-jscep.build-test.dir" location="${systemtests-jscep.dir}/build-test"/>
	<property name="systemtests-jscep.test.dir" location="${systemtests-jscep.dir}/src-test"/>

	<path id="test.classpath">
	    <path location="${systemtests-jscep.build-test.dir}"/>

		<path refid="lib.junit.classpath"/>
		<path refid="lib.jee-client.classpath"/>
		<path refid="lib.jaxb.classpath"/>
		<path refid="lib.cert-cvc.classpath" />
	    <path refid="lib.bouncycastle.classpath"/>
	    <path refid="lib.slf4jlog4j.classpath"/>
	    <path refid="lib.log4j.classpath"/>
	    <path refid="lib.nimbus-jose-jwt.classpath"/>
	    <path refid="lib.jakarta.servlet.classpath"/>
	    <path refid="lib.x509-common-util.classpath" />
	    <path refid="lib.cryptotokens.classpath"/>
	    <path refid="lib.ejbca-common.classpath"/>
		<path refid="lib.commons-codec.classpath"/>
		<path refid="lib.commons-io.classpath"/>
		<path refid="lib.commons-lang.classpath"/>
		<path location="${mod.cesecore-common.lib}"/>
		<path location="${mod.cesecore-ejb-interface.lib}"/>
        <path location="${mod.cesecore-entity.lib}"/>
	    <path location="${mod.edition-specific-interface.lib}"/>
	    <path location="${mod.ejbca-ejb-interface.lib}"/>
	    <path location="${systemtests-jscep.dir}/../dist/systemtests-interfaces.jar"/>
	    <path location="${systemtests-jscep.dir}/../dist/systemtests-common.jar"/>
	    <path location="${systemtests-jscep.dir}/../dist/systemtests-ejb.jar"/>

		<path location="${mod.cesecore-x509ca.lib}"/>
	</path>

    <target name="clean" description="Clean up this module">
		<delete dir="${systemtests-jscep.build-test.dir}" />
    </target>

    <target name="tests-compile">
    	<mkdir dir="${systemtests-jscep.build-test.dir}" />
    	<copy file="${log4j.test.file}" tofile="${systemtests-jscep.build-test.dir}/log4j.xml" failonerror="true"/>
    	<copy todir="${systemtests-jscep.build-test.dir}" failonerror="true">
            <fileset dir="${ejbca.home}/src" includes="intresources/**"/>
		    <fileset dir="${ejbca.home}/src/java/" includes="defaultvalues.properties"/>
		</copy>
		<!-- systemtests.properties needs to be in the classpath, if it exists for targeting non-default environment-->
		<copy file="${systemtests.properties.file}" todir="${systemtests-jscep.build-test.dir}" failonerror="false"/>
    	<!-- jndi.properties needs to be in the classpath, if it exists -->
    	<copy file="${jndi.properties.file}" tofile="${systemtests-jscep.build-test.dir}/jndi.properties" failonerror="false"/>
		<copy file="${jboss-ejb-client.properties}" todir="${systemtests-jscep.build-test.dir}" failonerror="true"/>
    	<javac srcdir="${systemtests-jscep.test.dir}" destdir="${systemtests-jscep.build-test.dir}" debug="on" includeantruntime="no"
    	        	encoding="UTF-8" target="${java.target.version}" classpathref="test.classpath">
			<sourcepath location="${mod.systemtests-jscep.path}/src-test/"/>
    	</javac>
    </target>


	<target name="test:system" depends="tests-compile">
		<antcall target="showtime" inheritall="true" inheritrefs="true"/>
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}" dir="${systemtests-jscep.test.dir}">
			<classpath>
				<path refid="test.classpath"/>
			</classpath>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${systemtests-jscep.build-test.dir}" includes="**/*SystemTest.class" />
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
		<antcall target="showtime" inheritall="true" inheritrefs="true"/>
	</target>

	<!-- =================================
          Run a single test specified with -Dtest.runone=TestName
         ================================= -->
	<target name="runone" depends="tests-compile">
		<fail message="'test.runone' is not set. Example -Dtest.runone=TestName . You can also use -Dtest.showoutput=true to send test output to console." unless="test.runone" />
		<junit printsummary="yes" haltonfailure="no" showoutput="${test.showoutput}">
			<classpath>
        		<path refid="test.classpath"/>
				<path location="${systemtests-jscep.build-test.dir}" />
			</classpath>
			<formatter type="xml" />
			<batchtest fork="yes" todir="${reports.dir}">
				<fileset dir="${systemtests-jscep.build-test.dir}" includes="**/${test.runone}.class"/>
			</batchtest>
			<jvmarg line="${tests.jvmargs}"/>
		</junit>
	</target>
</project>
